  title = {Species {{Identity}} and {{Initial Size Rather Than Neighborhood Interactions Influence Survival}} in a {{Response-Surface Examination}} of {{Competition}}},
  author = {Shen, Zhiqiang and Li, Yuanzhi and Chen, Zhiyi and Xi, Nianxun and Luo, Wenqi and He, Qing and Liu, Songling and Lin, Wei and Zhu, Xianhui and Fang, Suqin and Wang, Youshi and Li, Buhang and Chu, Chengjin},
